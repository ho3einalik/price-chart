# Environment configuration for ShopPilot

# Django Settings
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-in-production-123456789
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL)
DB_NAME=shoppilot
DB_USER=shoppilot_user
DB_PASSWORD=shoppilot_password
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
